# LLM プロバイダ設定
# LLM_PROVIDER: openai (デフォルト) | gemini | google
#   openai  — OpenAI API (LLM_API_KEY 必須)
#   gemini  — Google AI Studio API (LLM_API_KEY 必須)
#   google  — Google Vertex AI + ADC 認証 (LLM_API_KEY 不要、GCP 認証情報のみ必要)
LLM_PROVIDER=openai

# API キー — OpenAI の場合は sk-... / Gemini の場合は AI Studio の APIキー
# 後方互換: OPENAI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY も使用可
# LLM_PROVIDER=google の場合は不要 (ADC を使用)
LLM_API_KEY=sk-your-api-key-here

# --- OpenAI 利用時 ---
LLM_ANALYSIS_MODEL=o3-mini
LLM_EMBEDDING_MODEL=text-embedding-3-large
LLM_EMBEDDING_DIM=3072

# --- Gemini (AI Studio) 利用時 ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key
# LLM_ANALYSIS_MODEL=gemini-2.0-flash
# LLM_EMBEDDING_MODEL=text-embedding-004
# LLM_EMBEDDING_DIM=768

# --- Google Vertex AI + ADC 認証 ---
# LLM_API_KEY は不要。GCP 認証情報（ADC）を使用する。
# 認証方法 (いずれか):
#   1. ローカル開発: gcloud auth application-default login
#   2. サービスアカウントキー: GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
#   3. GCE / Cloud Run 上: メタデータサーバーが自動的に認証情報を提供
#
# Docker で実行する場合は docker-compose.yml の volumes セクションのコメントを参照。
# LLM_PROVIDER=google
# LLM_ANALYSIS_MODEL=gemini-2.5-flash
# LLM_EMBEDDING_MODEL=text-embedding-004
# LLM_EMBEDDING_DIM=768
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# GCP_USE_VERTEX_AI=true
# GOOGLE_APPLICATION_CREDENTIALS=/app/.gcp/application_default_credentials.json

# --- Gemini / Vertex AI ADC 認証 (廃止予定: LLM_PROVIDER=google を使用してください) ---
# LLM_PROVIDER=gemini-vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# LLM マルチモード設定 (Fast / Standard / Deep)
LLM_FAST_MODEL=gpt-5.4-nano
LLM_FAST_EFFORT=low
LLM_STANDARD_MODEL=gpt-5.2
LLM_STANDARD_EFFORT=medium
LLM_DEEP_MODEL=gpt-5.2
LLM_DEEP_EFFORT=high

# モデルティアごとの最大出力トークン数（エージェント LLM 呼び出しの max_tokens）。
# Fast は 400k、それ以外（Standard / Analysis / Deep）は 1M がデフォルト。
# AGENT_LLM_MAX_TOKENS を設定すると、ティアに関わらずその値で上書きされる（後方互換）。
LLM_FAST_MODEL_MAX_TOKENS=128000
LLM_STANDARD_MODEL_MAX_TOKENS=128000
LLM_ANALYSIS_MODEL_MAX_TOKENS=128000
LLM_DEEP_MODEL_MAX_TOKENS=128000

# --- TensionMiningAgent (B層) — 違和感候補検出のコスト制御 ---
# 1セッション（user×course×topic×日）あたりの LLM コール上限
TENSION_MAX_CALLS_PER_SESSION=3
# 1ユーザー1日あたりの LLM コール上限
TENSION_MAX_CALLS_PER_DAY=10
# 空なら fast tier（LLM_FAST_MODEL）を使用
# TENSION_LLM_MODEL=

# --- D層（Doubt Layer）— LLM 補助のコスト制御（tension とは独立のカウンタ） ---
# 検証スコープ候補抽出（D1-4）の 1 日あたり LLM コール上限
DOUBT_SCOPE_MAX_CALLS_PER_DAY=10
# 空なら fast tier（LLM_FAST_MODEL）を使用
# DOUBT_SCOPE_LLM_MODEL=
# 暗黙前提マイニングの LLM 正規化（D2-2）の 1 日あたりコール上限
DOUBT_ASSUMPTION_MAX_CALLS_PER_DAY=10
# 空なら fast tier（LLM_FAST_MODEL）を使用
# DOUBT_ASSUMPTION_LLM_MODEL=
# 反証条件候補抽出（SL-1, 賭け金の台帳）の 1 日あたり LLM コール上限
DOUBT_FALSIFICATION_MAX_CALLS_PER_DAY=10
# 空なら fast tier（LLM_FAST_MODEL）を使用
# DOUBT_FALSIFICATION_LLM_MODEL=

# --- 分野の地図 骨格エディタ AIアシスト編集（interpret / propose。P3/P4） ---
# 1教員1日あたりの assist LLM コール上限（interpret + propose の合算）
ATLAS_ASSIST_MAX_CALLS_PER_DAY=60
# 空なら分析 tier（LLM_ANALYSIS_MODEL）を使用（対象特定・編集生成には精度が要る）
# ATLAS_ASSIST_LLM_MODEL=

# --- ハンズフリー音声会話 (カジュアル対話モード) ---
# 音声文字起こしモデル（openai プロバイダのみ対応）
LLM_TRANSCRIBE_MODEL=whisper-1

# --- 横断ユーティリティ層（Admin Copilot） ---
# chat の intent 分類/応答の 1 ユーザー 1 日あたり LLM コール上限
ASSISTANT_MAX_CALLS_PER_DAY=20
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# ASSISTANT_LLM_MODEL=

# --- 再構成ループ（Reconstruction Loop, R層） ---
# 1 ドキュメントあたりの自動生成 item 上限
RECON_MAX_ITEMS_PER_DOCUMENT=30
# item オーサリング worker の 1 日あたり LLM コール上限（他機能と独立）
RECON_MAX_CALLS_PER_DAY=10
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# RECON_LLM_MODEL=

# --- discuss 開幕素材の生成（discuss_opening ステージ, Phase 1） ---
# 1 document あたりに生成する「議論のきっかけ」の上限（超過は truncated で正直に記録）
DISCUSS_OPENING_MAX_ITEMS_PER_DOCUMENT=4
# 生成ステージの 1 日あたり LLM コール上限（他機能と独立。1 document = 1 コール）
DISCUSS_OPENING_MAX_CALLS_PER_DAY=20
# 生成言語（学習者向け散文。lecture_language は使わない）
DISCUSS_OPENING_LANGUAGE=ja
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# DISCUSS_OPENING_LLM_MODEL=

# --- 知識ランドスケープの配置候補生成（landscape_placement ステージ, Phase L1） ---
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# LANDSCAPE_PLACEMENT_LLM_MODEL=
# 配置候補生成の 1 日あたり LLM コール上限（他機能と独立。1 document = 1 コールで
# 凍結骨格のある全ドメインを相対評価する。パイプラインと手動再提案が同じ予算を共有）
LANDSCAPE_MAX_CALLS_PER_DAY=20
# 1 document あたりに残す配置候補の上限（超過は weight 降順で切り、truncated で正直に記録）
LANDSCAPE_MAX_PLACEMENTS_PER_DOCUMENT=8

# --- 画像読み取りパイプライン（apparatus_semantics, L層） ---
# vision 同定モデル（v1 は OpenAI 経路のみ）
APPARATUS_LLM_MODEL=gpt-4o
# 1 document あたり vision 対象にする図の上限（超過は skipped_by_limit で保持）
APPARATUS_MAX_IMAGES_PER_DOCUMENT=20
# vision 呼び出しの日次上限（他機能と独立）
APPARATUS_MAX_CALLS_PER_DAY=30
# 含有承認済み例示画像の few-shot 添付（既定 off）
APPARATUS_FEWSHOT_IMAGES=false
# ライブラリ凍結版 retrieval の候補数
APPARATUS_RETRIEVAL_TOP_K=5

# --- チャット型 AI 支援の共通基盤整理（既定は現行挙動を保存） ---
# 学習チャット本体の 1 ユーザー 1 日あたり LLM コール上限（他機能と独立）
LEARNING_CHAT_MAX_CALLS_PER_DAY=300
# コースビルダーチャットの 1 ユーザー 1 日あたり LLM コール上限（他機能と独立）
COURSE_BUILDER_MAX_CALLS_PER_DAY=100
# 原稿スタジオ rewrite の 1 ユーザー 1 日あたり LLM コール上限（他機能と独立）
LECTURE_REWRITE_MAX_CALLS_PER_DAY=100
# 空なら analysis tier（LLM_ANALYSIS_MODEL）に委譲（現行の暗黙依存を明示化）
# LEARNING_CHAT_LLM_MODEL=
# 空なら analysis tier（LLM_ANALYSIS_MODEL）に委譲
# COURSE_BUILDER_LLM_MODEL=

# --- LLM トークン使用量推計（U層, Usage Metering） ---
# false で record() を no-op に（テスト・ローカル用）
LLM_USAGE_TRACKING_ENABLED=true
# in-memory バッファ上限。超過分は最古から破棄し dropped_events に計上する
LLM_USAGE_BUFFER_MAX=1000
# バックグラウンド flusher の周期（秒）
LLM_USAGE_FLUSH_INTERVAL_SECONDS=10
# この件数到達で flusher を即時起こす
LLM_USAGE_FLUSH_BATCH=100
# モデル単価表（JSON）のパス。空なら cost_usd は常に null（価格をハードコードしない）
# LLM_PRICE_TABLE_PATH=

# --- LLM モデル選択（M層, core/llm_policy.py） ---
# モデルカタログ（JSON）のパス。**空なら同梱の backend/config/llm_models.json を使う**
# （選択肢を増やす場所はこのファイル。実モデル名 / provider / capabilities("vision") /
# cost_hint(low|medium|high) を書く）。存在しないパスを指定するとカタログ無し扱いになり、
# 各画面の [変更] は無効化される（架空の候補を並べない fail-closed）
# LLM_MODEL_CATALOG_PATH=config/llm_models.json

# --- 管理画面の音声対話（グラフレビュー等, W層） ---
# 1教員1日あたりの音声 API コール上限（音声認識 + 読み上げの共通カウンタ）。
# 上限到達は事実文で 429（残数などの数値は返さない）
DELIBERATION_VOICE_MAX_CALLS_PER_DAY=200

# --- 教材図スタジオ（Teaching Figure Studio, migration 063） ---
# 図の対話生成とギャップ提案で使うモデル。空なら fast tier（LLM_FAST_MODEL）に委譲。
# 管理画面の「AIモデル」からも場面「教材図スタジオ」として上書きできる
# FIGURE_STUDIO_LLM_MODEL=
# 図の対話生成の 1教員1日あたり LLM コール上限（1図あたり数ターンの往復を想定）
FIGURE_STUDIO_MAX_CALLS_PER_DAY=60
# ギャップ提案の生成の 1教員1日あたり LLM コール上限（対話とは独立のカウンタ）
FIGURE_SUGGEST_MAX_CALLS_PER_DAY=20
# 保存できる SVG のサイズ上限（バイト）。サニタイザが入力・出力の両方で検査する
TEACHING_FIGURE_MAX_SVG_BYTES=200000
# 1トピックあたりのギャップ提案の最大件数（1コールで返させる上限）
TEACHING_FIGURE_MAX_SUGGESTIONS=4

# --- 論文レーダー（教材起点の類似論文探索と比較分析） ---
# 起点論文と候補アブストラクトの比較分析の 1教員1日あたり LLM コール上限
# （上限到達は事実文で 429。検索・距離帯とは独立のカウンタ）
DISCOVERY_COMPARE_MAX_CALLS_PER_DAY=20
# 比較分析のモデル。空なら fast tier（LLM_FAST_MODEL）に委譲。
# 管理画面の「AIモデル」からも場面「類似論文の比較分析」として上書きできる
# DISCOVERY_COMPARE_LLM_MODEL=

JWT_SECRET=change-this-to-a-random-secret
ADMIN_PASSWORD=your_secure_password
DATABASE_URL=postgresql://episteme:episteme@postgres:5432/episteme
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_ENDPOINT=localhost:9000
GROBID_URL=http://localhost:8070

# ── Docker Compose で動かす場合（docker-compose.yml） ─────────────────────
# このファイルは `env_file: .env` で api-server コンテナへそのまま注入される。
# ただし docker-compose.yml の `environment:` に書かれた変数はここより**優先される**。
# 2026-09-03 時点で優先されるのは
#   DATABASE_URL（下の DB_* から合成）/ GROBID_URL（既定 http://grobid:8070）/
#   GOOGLE_APPLICATION_CREDENTIALS（既定 /app/.gcp/application_default_credentials.json）/
#   LLM_FAST_MODEL / LLM_STANDARD_MODEL / LLM_DEEP_MODEL
# の6つ。
#
# コンテナ内のホスト名はサービス名になる点に注意（上の localhost:… はホストから直接
# uvicorn を動かす場合の値）。Docker で動かすときは MINIO_ENDPOINT=minio:9000 のように
# サービス名へ書き換えること。
#
# DB_* は docker-compose.yml が DATABASE_URL を組み立てるために参照する
# （compose の変数展開で使うので、値が無いと DATABASE_URL が壊れる）。
DB_USER=episteme
DB_PASSWORD=episteme
DB_HOST=postgres
DB_PORT=5432
DB_NAME=episteme

# minio サービスの初期認証情報（compose の minio.environment が参照する）。
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY を省略した場合のフォールバックにもなる。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── ngrok（docker-compose.prod.yml の ngrok コンテナ用）─────────────
# アプリのコードからは参照されません（compose が ngrok コンテナへ渡すだけの変数です）。
# docker-compose.prod.yml で外部公開トンネルを張るときのみ必要。
# ngrok アカウントを作成し、固定ドメインを取得してから設定してください。
# https://dashboard.ngrok.com/tunnels/agents
NGROK_AUTHTOKEN=your_ngrok_auth_token
NGROK_DOMAIN=your-subdomain.ngrok-free.app

# CORS 許可オリジン（カンマ区切り）。
# ngrok 経由アクセスを許可する場合は固定ドメインを追加してください。
# デフォルト "*" は全オリジン許可（開発用）。本番環境では明示的に設定すること。
# 例: CORS_ORIGINS=https://your-subdomain.ngrok-free.app,http://localhost:3000
CORS_ORIGINS=*

# Admin エラー解析画面で保持・返却するログ最大件数
ADMIN_ERROR_LOG_MAX_ITEMS=1000


# --- Domain Cartridge ---
# 使用するデフォルトのドメインカートリッジ
# 現時点では particle_physics のみを想定
EPISTEME_DEFAULT_CARTRIDGE_ID=particle_physics

# カートリッジ定義ディレクトリを変更したい場合のみ指定
# 未指定時は backend/cartridges を使用
# EPISTEME_CARTRIDGES_DIR=/app/cartridges


# --- Field Atlas (分野の地図) ---
# 学習UIの地図データソース。フロント (atlas-data.js) が
# GET /api/atlas/runtime-config 経由で参照する。
#   api     : 実データ (推奨・既定)。本番は必ず api にする。
#   fixture : モック地図 (ローカル開発の確認用のみ)。
# 本番でこれを fixture にすると全ユーザーにモック地図が表示されるので注意。
ATLAS_DATA_SOURCE=api


# =====================================================================
# 以下は 2026-09-03 の追補。それまで .env.example に未記載だった設定可能な
# 環境変数を、用途と既定値つきで一覧にした（正本はコード側 —
# backend/core/config.py の Settings（AliasChoices で env 名を宣言）と、
# 各モジュールの os.getenv）。
#
# **すべてコメントアウトしてある = 値はコード既定値のまま**。挙動を変えたい
# ときだけコメントを外して編集すること（このファイルをそのまま .env に
# コピーしても現行の挙動は変わらない）。
# =====================================================================

# --- LLM 呼び出しの共通設定 ---
# LLM API 呼び出しのリトライ回数（後方互換名 EPISTEME_LLM_MAX_RETRIES）
# LLM_MAX_RETRIES=3
# リトライ間隔のバックオフ係数（秒。後方互換名 EPISTEME_LLM_RETRY_BACKOFF_SECONDS）
# LLM_RETRY_BACKOFF_SECONDS=1.5
# レクチャー読み上げ（OpenAI TTS）の voice。多言語対応のため言語で分岐しない
# LECTURE_TTS_VOICE=alloy

# --- PDF 解析エージェントの LLM 呼び出しタイムアウト ---
# （正本: src/episteme_graph/agents/llm_json_client.py）
# 1 コールあたりのタイムアウト（秒）
# AGENT_LLM_TIMEOUT_SECONDS=300
# 同・ウォールクロック上限（秒）。未設定なら max(TIMEOUT+30, TIMEOUT*1.1) が使われる
# AGENT_LLM_WALL_TIMEOUT_SECONDS=
# 出力トークン上限の強制上書き。未設定ならモデルのティア別上限
# （LLM_FAST_MODEL_MAX_TOKENS 等）が使われる。設定すると全ティアに一律適用される
# AGENT_LLM_MAX_TOKENS=
# 概念構造抽出（core/theory_components.py）の LLM 呼び出しタイムアウト（秒）
# THEORY_EXTRACTION_TIMEOUT_SECONDS=45

# --- 構造帰属型の問い記録（B層 StructureAnchorAgent。tension とは独立のカウンタ） ---
# 1セッション（user×course×topic×日）あたりの LLM コール上限
# ANCHOR_MAX_CALLS_PER_SESSION=3
# 1ユーザー1日あたりの LLM コール上限
# ANCHOR_MAX_CALLS_PER_DAY=10
# 回答末尾の帰属確認プロンプト（方法C）のセッション内提示上限（毎回は出さない）
# ANCHOR_CONFIRM_MAX_PER_SESSION=3
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# ANCHOR_LLM_MODEL=

# --- 要素検討ワークスペース（W層）とグラフ対話レビュー ---
# 1セッションあたりの LLM コール上限
# DELIBERATION_MAX_CALLS_PER_SESSION=8
# 1ユーザー1日あたりの LLM コール上限（グラフ全体対話もこのカウンタを共有する）
# DELIBERATION_MAX_CALLS_PER_DAY=40
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# DELIBERATION_LLM_MODEL=
# 対話 grounding へ供給する同一性候補（同分野の凍結済みライブラリ項目）の件数上限
# DELIBERATION_IDENTITY_CANDIDATES_TOP_K=5

# --- 共通部品の標準化判定（W層 Phase S。他機能とは独立のカウンタ） ---
# 三角測量の証拠①（LLM 事前知識）の 1 日あたり LLM コール上限
# STDPART_MAX_CALLS_PER_DAY=10
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# STDPART_LLM_MODEL=

# --- 二層説明のうち文脈依存説明の生成ステージ（contextual_explanation） ---
# 1 document あたりに説明を付ける要素数の上限
# CTXEXPL_MAX_ELEMENTS_PER_DOCUMENT=40
# 生成ステージの 1 日あたり LLM コール上限
# CTXEXPL_MAX_CALLS_PER_DAY=20
# 空なら fast tier（LLM_FAST_MODEL）に委譲
# CTXEXPL_LLM_MODEL=

# --- 画像読み取りパイプライン（L層）の追加設定 ---
# 図ごとの周辺本文（figure_context 収集）の最大ブロック数
# APPARATUS_CONTEXT_MAX_ITEMS=12
# 同・合計文字数の上限
# APPARATUS_CONTEXT_MAX_CHARS=6000
# 解析方式。iterative（既定。文脈仮説→独立観察→照合→再スキャン）| one_shot（旧方式）
# APPARATUS_ANALYSIS_MODE=iterative
# バッチ解析（パイプライン）でのギャップ駆動再スキャンの最大試行回数
# APPARATUS_VERIFY_MAX_ITERATIONS=3
# 教員指示付き再解析（同期API）での最大試行回数。応答時間を守るため控えめ
# APPARATUS_REANALYZE_MAX_ITERATIONS=1

# --- カテゴリギャップ候補 / 分野マップのベクトル係留（VA層） ---
# 1 document あたりに保存するギャップ信号の上限（追加 LLM コールなし。0 で申告させない）
# LANDSCAPE_GAP_MAX_PER_DOCUMENT=3
# アンカーベクトル構築・近傍注記の embedding バッチ回数の日次上限
# ATLAS_VECTOR_MAX_CALLS_PER_DAY=50
# 配置候補生成の前段で LLM へ提示する concept の上限（0 で絞り込み無効。region は常に全提示）
# LANDSCAPE_VECTOR_PREFILTER_TOPK=32

# --- 論文ディスカバリー（Phase 3） ---
# 候補の関連度ランキング（embedding 1バッチ = 1コール）の日次上限。
# 上限到達は失敗ではなく「新着順で表示する」への fail-soft
# DISCOVERY_RANKING_MAX_CALLS_PER_DAY=100
# 引用グラフによる第2の候補供給源（Semantic Scholar）のオプトイン。既定 off
# DISCOVERY_CITATION_SOURCE_ENABLED=false

# --- 常駐 worker / 起動時の付帯処理（1|true|yes で有効、それ以外で無効） ---
# V層 削除猶予スイーパ（期限到来の pending_deletion を purge して通知する）
# VERSION_SWEEPER_ENABLED=1
# 同・実行周期（秒）
# VERSION_SWEEP_INTERVAL_SECONDS=3600
# 論文ディスカバリー 取り込みキュー worker（arXiv 検索はしない。キューの処理のみ）
# PAPER_DISCOVERY_WORKER_ENABLED=1
# 同・キューが空のときの待ち時間（秒）
# PAPER_DISCOVERY_WORKER_INTERVAL_SECONDS=30
# 状態遷移 watcher（状態管理・通知基盤）
# STATUS_WATCH_ENABLED=1
# 同・スキャン周期（秒）
# STATUS_WATCH_INTERVAL=60
# help_kb ベクトル補助層の同期・検索（既定 on。0 で無効）
# HELP_KB_VECTOR_ENABLED=1
# 分野の地図キャッシュの再計算をまとめる待ち時間（秒）
# ATLAS_REFRESH_DELAY_SECONDS=60

# --- その他 ---
# ISOM の出力先ディレクトリ
# ISOM_OUTPUT_DIR=output/incoming
