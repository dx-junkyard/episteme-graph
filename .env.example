# LLM 設定 (ベンダーニュートラル。後方互換のため OPENAI_* も使用可)
LLM_API_KEY=sk-your-api-key-here
LLM_ANALYSIS_MODEL=o3-mini
LLM_EMBEDDING_MODEL=text-embedding-3-large

# LLM マルチモード設定 (Fast / Standard / Deep)
LLM_FAST_MODEL=gpt-5.4-nano
LLM_FAST_EFFORT=low
LLM_STANDARD_MODEL=gpt-5.2
LLM_STANDARD_EFFORT=medium
LLM_DEEP_MODEL=gpt-5.2
LLM_DEEP_EFFORT=high
JWT_SECRET=change-this-to-a-random-secret
ADMIN_PASSWORD=your_secure_password
DATABASE_URL=postgresql://episteme:episteme@postgres:5432/episteme
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/password
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_ENDPOINT=localhost:9000
GROBID_URL=http://localhost:8070
