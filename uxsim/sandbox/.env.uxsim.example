# 砂場専用の上書き（.env の後に読まれる）。コピーして .env.uxsim にする（git 管理外）。
ADMIN_PASSWORD=uxsim-admin-change-me
JWT_SECRET=uxsim-jwt-secret-change-me
# 分野は入口で選ぶ（分野中立経路を踏む）
EPISTEME_DEFAULT_CARTRIDGE_ID=
# CostGate を campaign の量に合わせて上げる（s-quota-edge を走らせるときは既定に戻す）
LEARNING_CHAT_MAX_CALLS_PER_DAY=2000
COURSE_BUILDER_MAX_CALLS_PER_DAY=300
LECTURE_REWRITE_MAX_CALLS_PER_DAY=300
# ストリーミングは campaign ごとに切り替える
LEARNING_CHAT_STREAMING_ENABLED=false
LLM_USAGE_TRACKING_ENABLED=true
CORS_ORIGINS=http://localhost:3100
